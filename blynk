#define BLYNK_TEMPLATE_ID "****"
#define BLYNK_TEMPLATE_NAME "Tongkat Tunanetra"
#define BLYNK_AUTH_TOKEN "****"

#include <WiFi.h>
#include <BlynkSimpleEsp32.h>

// WiFi credentials
char ssid[] = "Wokwi-GUEST";
char pass[] = "";

// Blynk authentication token
char auth[] = BLYNK_AUTH_TOKEN;

// Pin for the LED
const int ledPin = 2;

void setup() {
  // Initialize the serial monitor
  Serial.begin(115200);

  // Set up the LED pin
  pinMode(ledPin, OUTPUT);

  // Connect to Wi-Fi
  Blynk.begin(auth, ssid, pass);
  Serial.println("Connecting to Wi-Fi...");
}

// Blynk virtual pin handler
BLYNK_WRITE(V0) {
  int ledState = param.asInt(); // Get the value from Blynk app
  digitalWrite(ledPin, ledState); // Control the LED
}

void loop() {
  Blynk.run(); // Run the Blynk loop
}
